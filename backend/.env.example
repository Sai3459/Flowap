DATABASE_URL=postgresql://postgres:devpass@localhost:5432/invoice_platform
EXTRACTION_SERVICE_URL=http://localhost:8001
PORT=3000

# Inbound email (optional). Without these the poller stays quiet and /inbound/poll
# reports that it is not configured. Per-tenant config arrives with the config plane;
# the password belongs in a secret store, not here.
INBOUND_IMAP_HOST=imap.example.com
INBOUND_IMAP_PORT=993
INBOUND_IMAP_USER=ap@example.com
INBOUND_IMAP_PASSWORD=
INBOUND_IMAP_MAILBOX=INBOX
INBOUND_TENANT_ID=
INBOUND_POLL_CRON=0 */5 * * * *
INBOUND_POLL_ENABLED=true

# Signs document URLs so GET /files/:name is not protected by an unguessable UUID alone.
# Required — the process refuses to serve documents unsigned. Same value on every replica,
# or links minted by one are refused by another.
FILE_URL_SIGNING_KEY=

# Encrypts ERP credentials at rest in erp_connections.config (AES-256-GCM). Required before
# any connection can be stored. Losing or changing it orphans every stored credential.
# Real deployments read this from a secret store, never from a file.
ERP_CREDENTIALS_KEY=
