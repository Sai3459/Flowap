# Base URL of the NestJS backend. Vite only exposes vars prefixed with VITE_ to the
# client, and the backend already runs with CORS enabled, so no dev proxy is needed.
VITE_API_BASE_URL=http://localhost:3000

# Prototype tenant resolution only. The backend reads x-tenant-id off the request;
# a production client must never pick its own tenant — that comes from the SSO
# session claim. See CLAUDE.md, "Core design decisions", item 4.
# Get one with: psql "$DATABASE_URL" -tAc "SELECT id FROM tenants LIMIT 1"
VITE_TENANT_ID=
