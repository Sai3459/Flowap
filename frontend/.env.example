# API base URL for the NestJS backend
VITE_API_BASE_URL=http://localhost:3000

# Default tenant UUID. The backend resolves tenants from a raw x-tenant-id header for now,
# so the UI has to supply one; it can also be switched at runtime in the header bar
# (stored in localStorage). Find one with: psql -c "SELECT id, name FROM tenants;"
VITE_TENANT_ID=
